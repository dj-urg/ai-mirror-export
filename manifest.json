{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "3.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-chat-exporter@daniel.jurg.vub.be",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "description": "Export conversations from ChatGPT, Claude, Copilot, Microsoft 365 Copilot, Perplexity, Grok, DeepSeek, Mistral and Google Search AI Overview to CSV. All processing happens locally in your browser.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://copilotstudio.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://m365.cloud.microsoft/*",
    "https://www.google.com/*",
    "https://www.google.be/*",
    "https://www.google.nl/*",
    "https://www.google.fr/*",
    "https://www.google.de/*",
    "https://www.google.co.uk/*",
    "https://www.google.es/*",
    "https://www.google.it/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/chatgpt/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/chatgpt/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/claude/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/claude/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://copilotstudio.microsoft.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/copilot/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://copilotstudio.microsoft.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/copilot/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/perplexity/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/perplexity/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/grok/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/grok/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/deepseek/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/deepseek/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/mistral/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/mistral/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/m365_copilot/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://m365.cloud.microsoft/*"
      ],
      "js": [
        "shared/message-security.js",
        "platforms/m365_copilot/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.be/search*",
        "https://www.google.nl/search*",
        "https://www.google.fr/search*",
        "https://www.google.de/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.es/search*",
        "https://www.google.it/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*"
      ],
      "js": [
        "platforms/google_search/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "AI Chat Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
  }
}