# ============================================================================
# Testing and Coverage
# ============================================================================

# testing/ is default-ignored (fixtures, baselines, generated CSVs, visual
# HTML harnesses). An explicit allowlist below tracks only the automated test
# scripts that are fixture-free, so CI can actually run them. Every file under
# testing/data/ stays ignored — the current fixtures are real-origin
# conversations captured from the project owner's own accounts (see
# testing/README.md "Test data may contain personal information"); they must
# be replaced with synthetic equivalents before being tracked.
testing/
!testing/
testing/*
!testing/tests/
testing/tests/*
!testing/tests/run_all.js
!testing/tests/test_pii.js
!testing/tests/test_manifest.js
!testing/tests/test_text_cleaner.js
!testing/tests/test_validators.js
!testing/tests/test_perplexity_extractor.js
!testing/tests/test_claude_golden.js
!testing/tests/test_perplexity_golden.js
!testing/tests/test_grok_golden.js
!testing/tests/test_deepseek_golden.js
!testing/tests/test_mistral_golden.js
!testing/tests/test_background_golden.js
!testing/tests/test_chatgpt_golden.js
!testing/tests/test_version_consistency.js
!testing/tests/test_pii_sweep.js
!testing/tests/test_message_security.js
!testing/tests/test_settings_domains.js
!testing/tests/helpers/
!testing/tests/helpers/**
# Synthetic (hand-built) fixtures used by the golden tests. Real-origin
# fixtures under testing/data/<platform>/ stay ignored.
!testing/data/
testing/data/*
!testing/data/synthetic/
!testing/data/synthetic/**
/*.csv
/conversation_*.csv
/chatgpt_*.csv

# Test coverage
coverage/
.nyc_output/
*.lcov

# ============================================================================
# Security and Secrets
# ============================================================================

# HAR / browser capture files contain cookies, auth headers and full
# conversation bodies. Never commit them.
*.har

# Claude Code local settings (machine-specific tool allowlist)
.claude/

.env
.env.local
.env.*.local
secrets.json
*.key
*.pem
*.cert

# ============================================================================
# KEEP THESE FILES (Essential Extension Files)
# ============================================================================
# The following files SHOULD be committed:
# - manifest.json (extension configuration)
# - popup.html (popup UI)
# - popup.js (popup logic)
# - content.js (content script)
# - icon.png (extension icon)
# - README.md (documentation)
# - *.md (all markdown documentation)
# - validate_extension.sh (validation script)
# - .gitignore (this file)

