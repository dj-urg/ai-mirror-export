# ============================================================================
# AI Chat Exporter - Git Ignore Configuration
# ============================================================================
# This file ensures only essential extension files are committed to the repo.
# Excludes development artifacts, OS files, and Python virtual environments.

# ============================================================================
# Python Virtual Environments
# ============================================================================
venv/
env/
ENV/
.venv/
.env/
data/
test/
*.pyc
__pycache__/
*.py[cod]
*$py.class

